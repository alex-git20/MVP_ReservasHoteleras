<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
        <title>Habitaciones</title>
    </head>
    
    <body>
        <div class="container mt-4">
            <h2>Habitaciones Disponibles</h2>
            <div class="container mt-5">
                <div class="row">
                    <% habitaciones.forEach(habitacion => { %>
                        <div class="col-12 mb-5">
                            <div class="row align-items-stretch bg-white">
                                
                                <!-- Columna de Texto y Botón (Izquierda) -->
                                <div class="col-lg-4 d-flex flex-column justify-content-center pe-lg-4 mb-4 mb-lg-0">
                                    <h3 class="text-uppercase fw-bold text-dark mb-3">
                                        <%= habitacion.nombre_tipo_habitacion %>
                                    </h3>
                                    
                                    <p class="text-muted small mb-4" style="line-height: 1.6;">
                                        Es la habitación ideal para disfrutar un gran confort en un ambiente relajante. Cuenta con excelentes amenidades, baño privado, TV con cable y servicio a la habitación.
                                        <br><br>
                                        <strong>Habitación:</strong> <%= habitacion.piso_habitacion %><%= habitacion.num_habitacion %>
                                    </p>
                                    
                                    <p class="text-muted fw-bold small mb-0">Precio por Noche</p>
                                    <div class="d-flex align-items-center gap-3 mt-1">
                                        <div>
                                            <span class="fs-3 fw-bold text-dark">$<%= habitacion.precio_tipo_habitacion %> MX </span>
                                        </div>
                                        <a href="/reservar/<%= habitacion.id_habitacion %>" class="btn btn-primary fw-bold px-4 py-2 rounded-1 shadow-sm mt-n2">
                                            RESERVAR AHORA
                                        </a>
                                    </div>
                                </div>

                                <!-- Columna de Imágenes (Derecha) -->
                                <div class="col-lg-8">
                                    <div class="row g-2 h-100">
                                        <!-- Imagen miniatura -->
                                        <div class="col-4">
                                            <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=400&q=80" 
                                                class="img-fluid w-100 h-100 object-fit-cover shadow-sm" alt="Detalle">
                                        </div>
                                        <!-- Imagen principal -->
                                        <div class="col-8">
                                            <img src="https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=800&q=80" 
                                                class="img-fluid w-100 h-100 object-fit-cover shadow-sm" alt="Habitación">
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <!-- Línea separadora sutil entre habitaciones -->
                            <hr class="mt-5 text-muted opacity-25">
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>    

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>