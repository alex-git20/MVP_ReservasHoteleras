<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reserva de Habitación</title>
  <!-- Bootstrap 5.3 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light py-5">

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
          <div class="card-header bg-primary text-white text-center py-3">
            <h4 class="mb-0">Reserva de Habitación</h4>
          </div>
          <div class="card-body p-4">

            
            <h2>Detalles de la Habitacion</h2>
            <p>Tipo de Habitacion: <%= habitacion.nombre_tipo_habitacion %></p>
            <p>Precio de la habitacion por noche: <%= habitacion.precio_tipo_habitacion %></p>
            
            <form id="formReserva" action="/reservar" method="POST">
              
              <!-- Tipo de Reserva -->
              <div class="mb-3">
                <label for="tipoReserva" class="form-label fw-bold">Tipo de Reserva</label>
                <select class="form-select" id="tipoReserva" name="tipo_reserva" required>
                  <option value="" selected disabled>Seleccione una opción...</option>
                  <option value="Persona Fisica">Persona Física</option>
                  <option value="Agencia">Agencia</option>
                </select>
              </div>

              <!-- Nombre de la persona/entidad que reserva -->
              <div class="mb-3">
                <label for="nomReserva" class="form-label fw-bold">Nombre de la persona o agencia que reserva</label>
                <input type="text" class="form-control" id="nomReserva" name="nom_reserva" placeholder="Ej. Juan Pérez / Viajes Global" required>
              </div>

              <!-- Nombre del Huésped (Solo si es Agencia) -->
              <div class="mb-3 d-none" id="campoHuesped">
                <label for="nomHuesped" class="form-label fw-bold">Nombre del Huésped</label>
                <input type="text" class="form-control" id="nomHuesped" name="nom_huesped" placeholder="Nombre completo del huésped">
              </div>

              <!-- Dirección -->
              <div class="mb-3">
                <label for="dirReserva" class="form-label fw-bold">Dirección Completa</label>
                <input type="text" class="form-control" id="dirReserva" name="dir_reserva" placeholder="Calle, número, colonia, ciudad, código postal" required>
              </div>

              <!-- Teléfono -->
              <div class="mb-3">
                <label for="telReserva" class="form-label fw-bold">Teléfono de Contacto</label>
                <input type="tel" class="form-control" id="telReserva" name="tel_reserva" placeholder="+52 123 456 7890" required>
              </div>

              <!-- Fechas -->
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label for="fechaInicio" class="form-label fw-bold">Fecha de Inicio</label>
                  <input type="date" class="form-control" id="fechaInicio" name="fecha_inicio_reserva" required>
                </div>
                <div class="col-md-6 mb-3">
                  <label for="fechaFin" class="form-label fw-bold">Fecha de Fin</label>
                  <input type="date" class="form-control" id="fechaFin" name="fecha_fin_reserva" required>
                </div>
              </div>

              <!-- Precio (Inyectado desde el backend - Solo lectura) -->
              <div class="mb-4">
                  <label class="form-label fw-bold">Precio Total de la Reserva</label>
                  <div class="p-3 bg-light border rounded shadow-sm">
                      <span class="fs-3 fw-bold text-primary">$<span id="textoPrecio">0.00</span> MXN</span>
                  </div>
                  
                  <!-- Este input está oculto, pero envía el dato al app.post -->
                  <input type="hidden" id="precioReserva" name="precio_reserva" value="0.00">
                  <div class="form-text">El total se calcula automáticamente según las fechas seleccionadas.</div>
              </div>

              <!-- Botón de Envío -->
              <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg">Reservar</button>
              </div>

            </form>

          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/bootstrap.bundle.min.js"></script>

  <!-- Script para mostrar/ocultar el campo "Huésped" -->
  <script>
    const selectTipoReserva = document.getElementById('tipoReserva');
    const campoHuesped = document.getElementById('campoHuesped');
    const inputHuesped = document.getElementById('nomHuesped');

    selectTipoReserva.addEventListener('change', function () {
      if (this.value === 'Agencia') {
        campoHuesped.classList.remove('d-none');
        inputHuesped.setAttribute('required', 'required');
      } else {
        campoHuesped.classList.add('d-none');
        inputHuesped.removeAttribute('required');
        inputHuesped.value = ''; 
      }
    });

    // 1. Capturamos los elementos
const fechaInicio = document.getElementById('fechaInicio');
const fechaFin = document.getElementById('fechaFin');
const inputPrecio = document.getElementById('precioReserva');
const textoPrecio = document.getElementById('textoPrecio'); // Captura el texto visual

// 2. Traemos el precio por noche directo desde tu backend a una variable JS
const precioPorNoche = parseFloat("<%= habitacion.precio_tipo_habitacion %>");

// 3. Función para calcular
function calcularTotal() {
    // Solo calculamos si ambas fechas tienen un valor
    if (fechaInicio.value && fechaFin.value) {
        const dateInicio = new Date(fechaInicio.value);
        const dateFin = new Date(fechaFin.value);

        // Restamos las fechas (el resultado es en milisegundos)
        const diferenciaMilisegundos = dateFin - dateInicio;
        
        // Convertimos milisegundos a días (1000ms * 60s * 60m * 24h)
        const dias = diferenciaMilisegundos / (1000 * 60 * 60 * 24);

        if (dias > 0) {
            // Calculamos el total y lo ponemos en el input con 2 decimales
           const total = (dias * precioPorNoche).toFixed(2);
           textoPrecio.textContent = total; // Actualiza el texto en pantalla
           inputPrecio.value = total;
        } else {
            // Si la fecha de fin es igual o menor a la de inicio
            inputPrecio.value = "0.00";
            // Opcional: mostrar un mensaje de error
        }
    }
}

// 4. Ejecutar la función cada vez que cambien los inputs de fecha
fechaInicio.addEventListener('change', calcularTotal);
fechaFin.addEventListener('change', calcularTotal);
  </script>
</body>
</html>