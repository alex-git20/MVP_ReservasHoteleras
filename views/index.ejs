<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
        <title>Hotel</title>
    </head>
    <body>
    
        <div class="container mt-4">

            <!-- INICIO DE LA ALERTA -->
            <% if (typeof exito !== 'undefined' && exito) { %>
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <strong>¡Reserva Confirmada!</strong> Tu habitación ha sido reservada con éxito.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <!-- FIN DE LA ALERTA -->

            <h2>Hoteles Disponibles</h2>
            <div class="row">
                <% hoteles.forEach(hotel => { %>
                    <div class="card mb-4 shadow-sm border-0 p-0">
                        <div class="row g-0">
                            
                            <!-- 1. Columna de la Imagen -->
                            <div class="col-md-4">
                                <!-- Usamos una imagen genérica de Unsplash de relleno, puedes cambiar la URL después -->
                                <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" 
                                    class="img-fluid rounded-start h-100" style="object-fit: cover;" alt="Fachada del hotel">
                            </div>

                            <!-- 2. Columna de los Detalles (Centro) -->
                            <div class="col-md-5 p-3">
                                <div class="d-flex align-items-center mb-1">
                                    <h4 class="card-title text-primary fw-bold mb-0 me-2"><%= hotel.nombre_hotel %></h4>
                                    <!-- Estrellas dinámicas -->
                                    <span class="text-warning fs-5">
                                        <% if (hotel.categoria_hotel_id === 1) { %>
                                            <% for(let i=0; i < 5; i++) { %>★<% } %>
                                        <%} else if (hotel.categoria_hotel_id === 2) { %>
                                            <% for(let i=0; i < 3; i++) { %>★<% } %>
                                            <% } %>
                                    </span>
                                </div>
                                
                                <a href="#" class="text-decoration-none text-primary fw-semibold small mb-2 d-block">
                                    📍 <%= hotel.direccion_hotel %> - Mostrar en el mapa
                                </a>
                                
                                <p class="card-text text-muted small mt-2">
                                    El <%= hotel.nombre_hotel %> ofrece una ubicación privilegiada con excelentes vistas a la ciudad. 
                                    Dispone de recepción 24 horas, wifi gratis y las mejores comodidades para tu estancia.
                                </p>
                            </div>

                            <!-- 3. Columna del Botón (Derecha) -->
                            <div class="col-md-3 d-flex flex-column justify-content-center p-3 border-start bg-light rounded-end">
                                <p class="text-end text-success fw-bold mb-2">¡Disponible!</p>
                                <a href="/hotel/<%= hotel.id_hotel %>" class="btn btn-primary btn-lg w-100 fw-bold">Ver Habitaciones</a>
                            </div>

                        </div>
                    </div>
                <% }); %>
            </div>
        </div>    
         
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>